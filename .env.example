# PyQuant environment configuration
# Copy to `.env` and fill in the keys you have. All keys are OPTIONAL —
# the tool runs on Yahoo Finance OHLCV alone. Each key unlocks one enrichment:

# FRED (macro features: Fed funds rate, CPI, yield curve). Free key:
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Finnhub (news headlines for sentiment scoring). Free key:
# https://finnhub.io/register
FINNHUB_API_KEY=

# Optional overrides for nested config (use __ delimiter), e.g.:
# TRAINING__MAX_EPOCHS=50
# DATA__PERIOD=10y
